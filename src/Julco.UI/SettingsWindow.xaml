<Window x:Class="Julco.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco Settings"
        Width="430"
        Height="360"
        MinWidth="390"
        MinHeight="330"
        WindowStartupLocation="CenterOwner"
        Background="#101217"
        Foreground="#F4F6F8"
        ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#AAB2C0" />
        <SolidColorBrush x:Key="BorderColor" Color="#2A2F3A" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="#202630" />
            <Setter Property="BorderBrush" Value="#3A4656" />
            <Setter Property="Foreground" Value="#F4F6F8" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#0F1218" />
            <Setter Property="BorderBrush" Value="#3A4656" />
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="CaretBrush" Value="#F4F6F8" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Runtime and capture preferences."
                       Foreground="{StaticResource MutedText}"
                       Margin="0,4,0,16" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Remote port" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
            <TextBox x:Name="CdpPortTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Captures folder" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,12,0,0" />
            <TextBox x:Name="CaptureDirectoryTextBox" Grid.Row="1" Grid.Column="1" Margin="0,12,8,0" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse" Click="BrowseButton_Click" Margin="0,12,0,0" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="File pattern" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,12,0,0" />
            <TextBox x:Name="FilePatternTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="History max" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,12,0,0" />
            <TextBox x:Name="HistoryMaxTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Lens delay ms" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,12,0,0" />
            <TextBox x:Name="LensDelayTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" />

            <CheckBox x:Name="TopmostCheckBox"
                      Grid.Row="5"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Content="Keep result windows on top"
                      Margin="0,14,0,0" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0" />
            <Button Content="Save" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
