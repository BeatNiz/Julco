<Window x:Class="Julco.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco Settings"
        Width="660"
        Height="720"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#101217"
        Foreground="#F4F6F8"
        ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#101217" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F6F8" />
        <SolidColorBrush x:Key="InputBackground" Color="#0F1218" />
        <SolidColorBrush x:Key="ControlBackground" Color="#202630" />
        <SolidColorBrush x:Key="MutedText" Color="#AAB2C0" />
        <SolidColorBrush x:Key="BorderColor" Color="#2A2F3A" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="RowBackground" Value="{StaticResource InputBackground}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource ControlBackground}" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Runtime and capture preferences."
                       Foreground="{StaticResource MutedText}"
                       Margin="0,4,0,16" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Remote port" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
            <TextBox x:Name="CdpPortTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Captures folder" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,12,0,0" />
            <TextBox x:Name="CaptureDirectoryTextBox" Grid.Row="1" Grid.Column="1" Margin="0,12,8,0" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse" Click="BrowseButton_Click" Margin="0,12,0,0" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="File pattern" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,12,0,0" />
            <TextBox x:Name="FilePatternTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="History max" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,12,0,0" />
            <TextBox x:Name="HistoryMaxTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Lens delay ms" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,12,0,0" />
            <TextBox x:Name="LensDelayTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Theme" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,12,0,0" />
            <ComboBox x:Name="ThemeComboBox"
                      Grid.Row="5"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="0,12,0,0" />

            <CheckBox x:Name="TopmostCheckBox"
                      Grid.Row="6"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Content="Keep result windows on top"
                      Margin="0,14,0,0" />

            <TextBlock Grid.Row="7"
                       Grid.Column="0"
                       Text="Shortcuts"
                       VerticalAlignment="Top"
                       Foreground="{StaticResource MutedText}"
                       Margin="0,18,0,0" />
            <StackPanel Grid.Row="7"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox x:Name="EnableGlobalShortcutsCheckBox"
                              Content="Global"
                              Margin="0,0,16,0" />
                    <CheckBox x:Name="EnableLocalShortcutsCheckBox"
                              Content="When Julco has focus" />
                </StackPanel>
                <DataGrid x:Name="ShortcutsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          MinHeight="190"
                          MaxHeight="240"
                          RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Action"
                                                Binding="{Binding ActionName}"
                                                IsReadOnly="True"
                                                Width="1.1*" />
                            <DataGridTextColumn Header="Purpose"
                                                Binding="{Binding Description}"
                                                IsReadOnly="True"
                                                Width="1.6*" />
                            <DataGridTextColumn Header="Global"
                                                Binding="{Binding GlobalShortcut, UpdateSourceTrigger=PropertyChanged}"
                                                Width="1.2*" />
                        <DataGridTextColumn Header="Local"
                                            Binding="{Binding LocalShortcut, UpdateSourceTrigger=PropertyChanged}"
                                            Width="1.1*" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Leave a shortcut blank to disable only that action. Use combinations like Ctrl+Alt+Shift+L."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedText}"
                           Margin="0,8,0,0" />
                <Button Content="Restore default shortcuts"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Click="RestoreShortcutsButton_Click" />
            </StackPanel>

            <TextBlock Grid.Row="8"
                       Grid.Column="0"
                       Text="Privacy"
                       VerticalAlignment="Top"
                       Foreground="{StaticResource MutedText}"
                       Margin="0,18,0,0" />
            <StackPanel Grid.Row="8"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="0,14,0,0">
                <CheckBox x:Name="RedactOnExportCheckBox"
                          Content="Redact sensitive data before exports and handoff drafts" />
                <CheckBox x:Name="RedactEmailsCheckBox"
                          Content="Emails"
                          Margin="0,8,0,0" />
                <CheckBox x:Name="RedactTokensCheckBox"
                          Content="Tokens, API keys, secrets, passwords, Authorization headers"
                          Margin="0,8,0,0" />
                <CheckBox x:Name="RedactCookiesCheckBox"
                          Content="Cookies and session identifiers"
                          Margin="0,8,0,0" />
                <CheckBox x:Name="RedactPrivateUrlsCheckBox"
                          Content="Private URL paths, query strings, fragments, and credentials"
                          Margin="0,8,0,0" />
                <CheckBox x:Name="RedactSelectedTextCheckBox"
                          Content="Visible text inside exported DOM/HTML"
                          Margin="0,8,0,0" />
                <CheckBox x:Name="IncludeScreenshotsInSafeExportsCheckBox"
                          Content="Include screenshots in safe exports"
                          ToolTip="Screenshots can contain visible private data. Keep this off unless you reviewed the image."
                          Margin="0,8,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="9"
                       Grid.Column="0"
                       Text="Issue trackers"
                       VerticalAlignment="Top"
                       Foreground="{StaticResource MutedText}"
                       Margin="0,18,0,0" />
            <StackPanel Grid.Row="9"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="0,14,0,0">
                <TextBlock Text="Optional direct publishing. Julco still creates local drafts when these are disabled."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedText}"
                           Margin="0,0,0,8" />
                <CheckBox x:Name="EnableGitHubCheckBox"
                          Content="Enable GitHub Issues submission" />
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Owner" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBox x:Name="GitHubOwnerTextBox" Grid.Row="0" Grid.Column="1" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Repo" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="GitHubRepositoryTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Labels" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="GitHubLabelsTextBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" ToolTip="Comma-separated labels. Julco does not create labels automatically." />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Token" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="GitHubTokenTextBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             Margin="0,8,0,0"
                             ToolTip="Optional. Leave blank to use JULCO_GITHUB_TOKEN." />
                </Grid>

                <CheckBox x:Name="EnableJiraCheckBox"
                          Content="Enable Jira submission"
                          Margin="0,16,0,0" />
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBox x:Name="JiraBaseUrlTextBox" Grid.Row="0" Grid.Column="1" ToolTip="Example: https://your-site.atlassian.net" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Project" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="JiraProjectKeyTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Issue type" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="JiraIssueTypeTextBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Email" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="JiraEmailTextBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Token" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox x:Name="JiraApiTokenTextBox"
                             Grid.Row="4"
                             Grid.Column="1"
                             Margin="0,8,0,0"
                             ToolTip="Optional. Leave blank to use JULCO_JIRA_API_TOKEN." />
                </Grid>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0" />
            <Button Content="Save" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
