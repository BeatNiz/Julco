<Window x:Class="Julco.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco Settings"
        Width="760"
        Height="720"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#101217"
        Foreground="#F4F6F8"
        ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#101217" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F6F8" />
        <SolidColorBrush x:Key="InputBackground" Color="#0F1218" />
        <SolidColorBrush x:Key="ControlBackground" Color="#202630" />
        <SolidColorBrush x:Key="MutedText" Color="#AAB2C0" />
        <SolidColorBrush x:Key="BorderColor" Color="#2A2F3A" />
        <SolidColorBrush x:Key="StatusReady" Color="#45D483" />
        <SolidColorBrush x:Key="StatusWarning" Color="#FFCA5C" />
        <SolidColorBrush x:Key="StatusDisabled" Color="#AAB2C0" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="RowBackground" Value="{StaticResource InputBackground}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource ControlBackground}" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Tune Julco by workflow: browser, lens, privacy, shortcuts, integrations, and advanced limits."
                       Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,16" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Appearance" FontWeight="SemiBold" />
                        <TextBlock Text="Choose how Julco presents itself while keeping inspector windows readable."
                                   Foreground="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,12" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Theme" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeComboBox" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Text="Result windows" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,14,0,0" />
                            <CheckBox x:Name="TopmostCheckBox"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      Content="Keep result windows on top"
                                      Margin="0,14,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Browser">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Browser connection" FontWeight="SemiBold" />
                        <TextBlock Text="Remote inspection uses the configured local port for Chromium CDP and Firefox BiDi."
                                   Foreground="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Remote port" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBox x:Name="CdpPortTextBox" Grid.Column="1" ToolTip="Usually 9222. Use another port when a browser/debug session already uses it." />
                        </Grid>
                        <TextBlock Text="Recommended: start browsers from Julco so the remote inspection endpoint is created correctly."
                                   Foreground="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Lens">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Lens behavior" FontWeight="SemiBold" />
                        <TextBlock Text="Control live inspection pacing. Higher delay uses fewer resources; lower delay feels more immediate."
                                   Foreground="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Lens delay ms" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBox x:Name="LensDelayTextBox" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Privacy">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Safe exports" FontWeight="SemiBold" />
                        <TextBlock Text="These rules are applied before exports, safe packages, and issue handoff drafts."
                                   Foreground="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,12" />
                        <CheckBox x:Name="RedactOnExportCheckBox"
                                  Content="Redact sensitive data before exports and handoff drafts" />
                        <CheckBox x:Name="RedactEmailsCheckBox" Content="Emails" Margin="0,8,0,0" />
                        <CheckBox x:Name="RedactTokensCheckBox"
                                  Content="Tokens, API keys, secrets, passwords, Authorization headers"
                                  Margin="0,8,0,0" />
                        <CheckBox x:Name="RedactCookiesCheckBox"
                                  Content="Cookies and session identifiers"
                                  Margin="0,8,0,0" />
                        <CheckBox x:Name="RedactPrivateUrlsCheckBox"
                                  Content="Private URL paths, query strings, fragments, and credentials"
                                  Margin="0,8,0,0" />
                        <CheckBox x:Name="RedactSelectedTextCheckBox"
                                  Content="Visible text inside exported DOM/HTML"
                                  Margin="0,8,0,0" />
                        <CheckBox x:Name="IncludeScreenshotsInSafeExportsCheckBox"
                                  Content="Include screenshots in safe exports"
                                  ToolTip="Screenshots can contain visible private data. Keep this off unless you reviewed the image."
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Shortcuts">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Keyboard control" FontWeight="SemiBold" />
                        <TextBlock Text="Leave a shortcut blank to disable only that action. Use combinations like Ctrl+Alt+Shift+L."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedText}"
                                   Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox x:Name="EnableGlobalShortcutsCheckBox"
                                      Content="Global"
                                      Margin="0,0,16,0" />
                            <CheckBox x:Name="EnableLocalShortcutsCheckBox"
                                      Content="When Julco has focus" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="ShortcutsDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionName}" IsReadOnly="True" Width="1.1*" />
                            <DataGridTextColumn Header="Purpose" Binding="{Binding Description}" IsReadOnly="True" Width="1.7*" />
                            <DataGridTextColumn Header="Global" Binding="{Binding GlobalShortcut, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                            <DataGridTextColumn Header="Local" Binding="{Binding LocalShortcut, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2"
                            Content="Restore default shortcuts"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Click="RestoreShortcutsButton_Click" />
                </Grid>
            </TabItem>

            <TabItem Header="Integrations">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Issue trackers" FontWeight="SemiBold" />
                        <TextBlock Text="Optional direct publishing. Julco still creates local drafts when these are disabled."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedText}"
                                   Margin="0,4,0,14" />

                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="GitHub Issues" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                    <TextBlock x:Name="GitHubStatusTextBlock"
                                               Text="Disabled"
                                               Foreground="{StaticResource StatusDisabled}"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                                <CheckBox x:Name="EnableGitHubCheckBox"
                                          Content="Enable GitHub Issues submission"
                                          Margin="0,10,0,0" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Owner" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    <TextBox x:Name="GitHubOwnerTextBox" Grid.Column="1" />
                                    <TextBlock Grid.Row="1" Text="Repo" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox x:Name="GitHubRepositoryTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="2" Text="Labels" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox x:Name="GitHubLabelsTextBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" ToolTip="Comma-separated labels. Julco does not create labels automatically." />
                                    <TextBlock Grid.Row="3" Text="Assignees" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox x:Name="GitHubAssigneesTextBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" ToolTip="Optional comma-separated GitHub usernames." />
                                    <TextBlock Grid.Row="4" Text="Milestone" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox x:Name="GitHubMilestoneTextBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" ToolTip="Optional GitHub milestone number." />
                                    <TextBlock Grid.Row="5" Text="Token" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox x:Name="GitHubTokenTextBox" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" ToolTip="Optional. Leave blank to keep saved token or use JULCO_GITHUB_TOKEN." />
                                </Grid>
                                <Button x:Name="TestGitHubButton"
                                        Content="Test GitHub connection"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        Click="TestGitHubButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Jira" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                    <TextBlock x:Name="JiraStatusTextBlock"
                                               Text="Disabled"
                                               Foreground="{StaticResource StatusDisabled}"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                                <CheckBox x:Name="EnableJiraCheckBox"
                                          Content="Enable Jira submission"
                                          Margin="0,10,0,0" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Base URL" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    <TextBox x:Name="JiraBaseUrlTextBox" Grid.Column="1" ToolTip="Example: https://your-site.atlassian.net" />
                                    <TextBlock Grid.Row="1" Text="Project" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox x:Name="JiraProjectKeyTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="2" Text="Issue type" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox x:Name="JiraIssueTypeTextBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="3" Text="Priority" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox x:Name="JiraPriorityTextBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" ToolTip="Optional Jira priority name, such as High or Medium." />
                                    <TextBlock Grid.Row="4" Text="Email" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox x:Name="JiraEmailTextBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="5" Text="Token" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox x:Name="JiraApiTokenTextBox" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" ToolTip="Optional. Leave blank to keep saved token or use JULCO_JIRA_API_TOKEN." />
                                </Grid>
                                <Button x:Name="TestJiraButton"
                                        Content="Test Jira connection"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        Click="TestJiraButton_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Storage and history" FontWeight="SemiBold" />
                        <TextBlock Text="Control where evidence packages are saved and how long capture history remains visible."
                                   Foreground="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,12" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Captures folder" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBox x:Name="CaptureDirectoryTextBox" Grid.Column="1" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="Browse" Click="BrowseButton_Click" />
                            <TextBlock Grid.Row="1" Text="File pattern" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <TextBox x:Name="FilePatternTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" />
                            <TextBlock Grid.Row="2" Text="History max" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <TextBox x:Name="HistoryMaxTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0" />
            <Button Content="Save" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
