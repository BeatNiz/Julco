<Window x:Class="Julco.UI.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco Result"
        Width="720"
        Height="520"
        MinWidth="360"
        MinHeight="260"
        Background="#101217"
        Foreground="#F4F6F8"
        Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#181B22"
                BorderBrush="#2A2F3A"
                BorderThickness="0,0,0,1">
            <TextBlock x:Name="TitleTextBlock"
                       VerticalAlignment="Center"
                       Margin="14,0"
                       FontWeight="SemiBold" />
        </Border>

        <TextBox x:Name="ContentTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="13" />
    </Grid>
</Window>
