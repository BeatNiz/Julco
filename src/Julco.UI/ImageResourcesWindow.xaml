<Window x:Class="Julco.UI.ImageResourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco - Images"
        Width="980"
        Height="680"
        MinWidth="640"
        MinHeight="480"
        Background="#101217"
        Foreground="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#AAB2C0" />
        <SolidColorBrush x:Key="BorderColor" Color="#2A2F3A" />
        <SolidColorBrush x:Key="PanelBackground" Color="#181B22" />
        <SolidColorBrush x:Key="InputBackground" Color="#050608" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="#202630" />
            <Setter Property="BorderBrush" Value="#3A4656" />
            <Setter Property="Foreground" Value="#F4F6F8" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="CountTextBlock"
                       DockPanel.Dock="Left"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="Images" />
            <TextBlock Text="The first item is the exact lens frame when available. Other entries come from IMG/SVG/source/srcset, video posters, and CSS image references."
                       Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="18,2,0,0" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ImagesListBox"
                     Grid.Column="0"
                     DisplayMemberPath="DisplayName"
                     Background="{StaticResource InputBackground}"
                     Foreground="#F4F6F8"
                     BorderBrush="{StaticResource BorderColor}"
                     SelectionChanged="ImagesListBox_SelectionChanged" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="170" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource InputBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1">
                    <Grid>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               Margin="12" />
                        <TextBlock x:Name="PreviewPlaceholderTextBlock"
                                   Text="Select an image to preview it."
                                   Foreground="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </Grid>
                </Border>

                <DataGrid x:Name="MetadataGrid"
                          Grid.Row="1"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          Background="{StaticResource InputBackground}"
                          Foreground="#F4F6F8"
                          BorderBrush="{StaticResource BorderColor}"
                          GridLinesVisibility="Horizontal"
                          Margin="0,12,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Field"
                                            Binding="{Binding Field}"
                                            Width="150" />
                        <DataGridTextColumn Header="Value"
                                            Binding="{Binding Value}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="DetailsTextBlock"
                       Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="No image selected." />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Copy URL"
                        Click="CopyUrlButton_Click"
                        Margin="0,0,8,0" />
                <Button Content="Copy details"
                        Click="CopyDetailsButton_Click"
                        Margin="0,0,8,0" />
                <Button Content="Open"
                        Click="OpenButton_Click"
                        Margin="0,0,8,0" />
                <Button Content="Save"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
