<Window x:Class="Julco.UI.ImageResourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco - Images"
        Width="820"
        Height="620"
        MinWidth="520"
        MinHeight="420"
        Background="#101217"
        Foreground="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#AAB2C0" />
        <SolidColorBrush x:Key="BorderColor" Color="#2A2F3A" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="#202630" />
            <Setter Property="BorderBrush" Value="#3A4656" />
            <Setter Property="Foreground" Value="#F4F6F8" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="CountTextBlock"
                       DockPanel.Dock="Left"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="Images" />
            <TextBlock Text="Detected from IMG, SVG, picture/source/srcset, video posters, CSS backgrounds, border/list/content images, and common web image formats."
                       Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="18,2,0,0" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ImagesListBox"
                     Grid.Column="0"
                     DisplayMemberPath="DisplayName"
                     Background="#050608"
                     Foreground="#F4F6F8"
                     BorderBrush="{StaticResource BorderColor}"
                     SelectionChanged="ImagesListBox_SelectionChanged" />

            <Border Grid.Column="2"
                    Background="#050608"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           Margin="12" />
                    <TextBlock x:Name="PreviewPlaceholderTextBlock"
                               Text="Select an image to preview it."
                               Foreground="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="DetailsTextBlock"
                       Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="No image selected." />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Copy URL"
                        Click="CopyUrlButton_Click"
                        Margin="0,0,8,0" />
                <Button Content="Open"
                        Click="OpenButton_Click"
                        Margin="0,0,8,0" />
                <Button Content="Save"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
