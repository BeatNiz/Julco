<Window x:Class="Julco.UI.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco Help"
        Width="560"
        Height="620"
        MinWidth="460"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#101217"
        Foreground="#F4F6F8"
        ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#AAB2C0" />
        <SolidColorBrush x:Key="BorderColor" Color="#2A2F3A" />
        <SolidColorBrush x:Key="PanelBackground" Color="#161A22" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Background" Value="#202630" />
            <Setter Property="BorderBrush" Value="#3A4656" />
            <Setter Property="Foreground" Value="#F4F6F8" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Help" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="A short guide for inspecting pages, using the lens, and choosing local browser ports."
                       Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,16" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Quick Start" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="1. Choose a local remote-inspection port. Use one port per browser session to avoid collisions.&#x0a;2. Open Chrome, Edge, Opera, or Firefox from Julco.&#x0a;3. Press Tabs and choose the page you want to inspect.&#x0a;4. Inspect a CSS selector or open Lens to inspect the framed area.&#x0a;5. Use Capture lens to save the screenshot plus DOM, CSS, Console, and Attributes.&#x0a;6. Use Captures to open, rename, delete, or refresh generated capture packages." />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Recommended Browser Ports" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Browser" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Port" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Use" FontWeight="SemiBold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Chrome" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="9222" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Default Chromium CDP session." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Edge" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="9223" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Separate CDP session for Microsoft Edge." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Opera" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="9224" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Opera is Chromium-based, so CDP works here too." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Firefox" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="9225" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Firefox uses WebDriver BiDi through its Remote Agent, not Chrome DevTools Protocol." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Alternates" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="9333-9340" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Use when a default port is already busy or you need parallel test sessions." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Good Practices" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Keep CDP ports local and avoid exposing them to public networks. If Julco cannot connect, close old browser sessions or choose another free port. For the cleanest captures, place the lens exactly over the target area before pressing Capture lens." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Close" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
