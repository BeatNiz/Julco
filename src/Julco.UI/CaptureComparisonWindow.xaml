<Window x:Class="Julco.UI.CaptureComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco - Compare Captures"
        Width="1100"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#101217"
        Foreground="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#AAB2C0" />
        <SolidColorBrush x:Key="BorderColor" Color="#2A2F3A" />
        <SolidColorBrush x:Key="InputBackground" Color="#050608" />
        <SolidColorBrush x:Key="ControlBackground" Color="#202630" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="#F4F6F8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="#101217" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="CaretBrush" Value="#F4F6F8" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Capture A"
                       Foreground="{StaticResource MutedText}" />
            <TextBlock Grid.Column="2"
                       Text="Capture B"
                       Foreground="{StaticResource MutedText}" />
            <ComboBox x:Name="CaptureAComboBox"
                      Grid.Row="1"
                      Grid.Column="0"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="CaptureComboBox_SelectionChanged"
                      Margin="0,4,0,0" />
            <ComboBox x:Name="CaptureBComboBox"
                      Grid.Row="1"
                      Grid.Column="2"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="CaptureComboBox_SelectionChanged"
                      Margin="0,4,12,0" />
            <Button Grid.Row="1"
                    Grid.Column="3"
                    Content="Save report"
                    Click="SaveReportButton_Click"
                    Margin="0,4,0,0" />
        </Grid>

        <TabControl Grid.Row="1"
                    Background="#101217"
                    Foreground="#F4F6F8">
            <TabItem Header="Visual">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="A"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2"
                               Text="B"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4"
                               Text="Visual diff"
                               FontWeight="SemiBold" />

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Background="{StaticResource InputBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            Margin="0,6,0,0">
                        <Image x:Name="ImageA"
                               Stretch="Uniform"
                               Margin="10" />
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="2"
                            Background="{StaticResource InputBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            Margin="0,6,0,0">
                        <Image x:Name="ImageB"
                               Stretch="Uniform"
                               Margin="10" />
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="4"
                            Background="{StaticResource InputBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            Margin="0,6,0,0">
                        <Image x:Name="DiffImage"
                               Stretch="Uniform"
                               Margin="10" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Technical">
                <TextBox x:Name="TechnicalTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         Padding="10"
                         Margin="0,10,0,0" />
            </TabItem>

            <TabItem Header="Files">
                <TextBox x:Name="FilesTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         Padding="10"
                         Margin="0,10,0,0" />
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Foreground="{StaticResource MutedText}"
                   Text="Choose two captures to compare."
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />
    </Grid>
</Window>
