<Window x:Class="Julco.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco"
        Icon="/Julco.UI;component/Resources/julco.ico"
        Width="1180"
        Height="760"
        MinWidth="260"
        MinHeight="520"
        WindowStyle="None"
        Background="#101217"
        Foreground="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#181B22" />
        <SolidColorBrush x:Key="BorderColor" Color="#2A2F3A" />
        <SolidColorBrush x:Key="MutedText" Color="#AAB2C0" />
        <SolidColorBrush x:Key="ControlBackground" Color="#202630" />
        <SolidColorBrush x:Key="ControlHover" Color="#2A3340" />
        <SolidColorBrush x:Key="ControlPressed" Color="#334155" />
        <SolidColorBrush x:Key="InputBackground" Color="#0F1218" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F6F8" />
        <SolidColorBrush x:Key="ListBackground" Color="#111318" />
        <SolidColorBrush x:Key="Accent" Color="#40C7FF" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHover}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlPressed}" />
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryText}" />
            <Setter Property="SelectionBrush" Value="#40C7FF" />
        </Style>
        <Style x:Key="BrowserLogoButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="WindowChromeButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHover}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseWindowChromeButton" TargetType="Button" BasedOn="{StaticResource WindowChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D64545" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#F87171" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B91C1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder"
                Grid.Row="0"
                Background="#181B22"
                BorderBrush="#2A2F3A"
                BorderThickness="0,0,0,1">
            <Grid x:Name="HeaderPanel"
                  Margin="14,8"
                  MouseLeftButtonDown="HeaderPanel_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderTopRow" Height="Auto" />
                    <RowDefinition x:Name="HeaderActionsRow" Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderLogoColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="TitleBarControlsPanel"
                            Grid.Row="0"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button x:Name="HelpButton"
                            Content="?"
                            Style="{StaticResource WindowChromeButton}"
                            ToolTip="Open Julco help and recommended browser ports."
                            Click="HelpButton_Click" />
                    <Button x:Name="MinimizeButton"
                            Content="−"
                            Style="{StaticResource WindowChromeButton}"
                            ToolTip="Minimize"
                            Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeButton"
                            Content="▢"
                            Style="{StaticResource WindowChromeButton}"
                            ToolTip="Maximize or restore"
                            Click="MaximizeButton_Click" />
                    <Button x:Name="CloseButton"
                            Content="×"
                            FontSize="14"
                            Style="{StaticResource CloseWindowChromeButton}"
                            ToolTip="Close"
                            Click="CloseButton_Click" />
                </StackPanel>

                <Image x:Name="LogoImage"
                       Grid.Row="0"
                       Grid.Column="0"
                       Source="/Julco.UI;component/Resources/julco-logo-dark.png"
                       Width="62"
                       Height="62"
                       VerticalAlignment="Center"
                       Stretch="Uniform"
                       ToolTip="Julco" />

                <WrapPanel x:Name="HeaderActionsPanel"
                           Grid.Row="0"
                           Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="10,0,0,0">
                    <TextBlock Text="CDP"
                               x:Name="PortLabelTextBlock"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="PortTextBox"
                             Width="72"
                             Text="9222"
                             ToolTip="Local port used to connect through Chrome DevTools Protocol."
                             Margin="0,0,8,0" />
                    <Button x:Name="LaunchChromeButton"
                            Style="{StaticResource BrowserLogoButton}"
                            ToolTip="Open Chrome with the configured CDP port."
                            Click="LaunchChromeButton_Click"
                            Margin="0,0,8,0">
                        <Image Source="/Julco.UI;component/Resources/Chrome.png"
                               Width="21"
                               Height="21"
                               Stretch="Uniform" />
                    </Button>
                    <Button x:Name="LaunchEdgeButton"
                            Style="{StaticResource BrowserLogoButton}"
                            ToolTip="Open Microsoft Edge with the configured CDP port."
                            Click="LaunchEdgeButton_Click"
                            Margin="0,0,8,0">
                        <Image Source="/Julco.UI;component/Resources/Edge.png"
                               Width="21"
                               Height="21"
                               Stretch="Uniform" />
                    </Button>
                    <Button x:Name="LaunchFirefoxButton"
                            Style="{StaticResource BrowserLogoButton}"
                            ToolTip="Open Firefox with WebDriver BiDi on the configured port."
                            Click="LaunchFirefoxButton_Click"
                            Margin="0,0,8,0">
                        <Image Source="/Julco.UI;component/Resources/Firefox.png"
                               Width="21"
                               Height="21"
                               Stretch="Uniform" />
                    </Button>
                    <Button x:Name="LaunchOperaButton"
                            Style="{StaticResource BrowserLogoButton}"
                            ToolTip="Open Opera with the configured CDP port."
                            Click="LaunchOperaButton_Click"
                            Margin="0,0,8,0">
                        <Image Source="/Julco.UI;component/Resources/Opera.png"
                               Width="21"
                               Height="21"
                               Stretch="Uniform" />
                    </Button>
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource BrowserLogoButton}"
                            ToolTip="Open Julco settings."
                            Click="SettingsButton_Click"
                            Margin="0,0,10,0">
                        <Image x:Name="SettingsIconImage"
                               Source="/Julco.UI;component/Resources/settings.png"
                               Width="18"
                               Height="18"
                               Stretch="Uniform" />
                    </Button>
                    <Button x:Name="RefreshTargetsButton"
                            Content="Tabs"
                            ToolTip="Refresh the list of inspectable web pages."
                            Click="RefreshTargetsButton_Click"
                            Margin="0,0,8,0" />
                    <Button x:Name="LensButton"
                            ToolTip="Open or close the technical lens frame."
                            Click="LensButton_Click"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="LensIconImage"
                                   Source="/Julco.UI;component/Resources/Lens.png"
                                   Width="16"
                                   Height="16"
                                   Stretch="Uniform"
                                   Margin="0,0,6,0" />
                            <TextBlock x:Name="LensButtonTextBlock" Text="Lens" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="330" />
                <ColumnDefinition x:Name="GapColumn" Width="16" />
                <ColumnDefinition x:Name="ResultsColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="InspectorTitleTextBlock"
                                   Text="CDP Inspection"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="InspectorHelpTextBlock"
                                   Text="Open Chrome or Edge from Julco, choose a tab, and inspect a CSS selector."
                                   Margin="0,8,0,16"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedText}" />

                        <TextBlock Text="Tab"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedText}" />
                        <ComboBox x:Name="TargetsComboBox"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="Web page to inspect through CDP."
                                  Margin="0,4,0,14" />

                        <TextBlock Text="CSS selector"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedText}" />
                        <TextBox x:Name="SelectorTextBox"
                                 Text="body"
                                 ToolTip="CSS selector to inspect. Examples: body, #app, .card, button."
                                 Margin="0,4,0,10" />

                        <Button x:Name="InspectButton"
                                Content="Inspect selector"
                                ToolTip="Get DOM, computed CSS, matched rules, and attributes for the selector."
                                Click="InspectButton_Click"
                                Margin="0,0,0,10" />

                        <Border x:Name="InspectionSummaryBorder"
                                Background="{StaticResource ListBackground}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Element" FontSize="11" Foreground="{StaticResource MutedText}" />
                                <TextBlock x:Name="ElementTextBlock"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Text="-"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="URL" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" />
                                <TextBlock x:Name="UrlTextBlock"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Text="-"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Lens" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" />
                                <TextBlock x:Name="LensStateTextBlock"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Text="Inactive"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid x:Name="ListsGrid" Grid.Row="1" Margin="0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="HistoryRow" Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="CapturesRow" Height="1.2*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="HistoryListBox"
                                 Grid.Row="0"
                                 MinHeight="72"
                                 Background="{StaticResource ListBackground}"
                                 Foreground="{StaticResource PrimaryText}"
                                 BorderBrush="{StaticResource BorderColor}" />

                        <TextBlock Grid.Row="1"
                                   Text="Captures"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedText}"
                                   Margin="0,10,0,4" />

                        <ListBox x:Name="CaptureFilesListBox"
                                 Grid.Row="2"
                                 DisplayMemberPath="DisplayName"
                                 MinHeight="90"
                                 Background="{StaticResource ListBackground}"
                                 Foreground="{StaticResource PrimaryText}"
                                 BorderBrush="{StaticResource BorderColor}"
                                 SelectionChanged="CaptureFilesListBox_SelectionChanged" />

                        <Border Grid.Row="3"
                                Background="{StaticResource InputBackground}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                Padding="8"
                                Margin="0,6,0,0">
                            <TextBlock x:Name="CaptureNotesPreviewTextBlock"
                                       Text="No capture selected."
                                       Foreground="{StaticResource MutedText}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="48" />
                        </Border>
                    </Grid>

                    <StackPanel x:Name="ActionButtonsPanel" Grid.Row="2">
                        <Button x:Name="CaptureLensButton"
                                Content="Evidence capture"
                                ToolTip="Save a clean evidence package with screenshot, DOM, CSS, console, attributes, page context, frame size, and notes."
                                Click="CaptureLensButton_Click"
                                Margin="0,0,0,6" />
                        <UniformGrid x:Name="CaptureActionsGrid"
                                     Columns="2"
                                     Margin="0,0,0,8">
                            <Button x:Name="OpenCaptureButton"
                                    Content="Open"
                                    ToolTip="Open the selected capture folder."
                                    Click="OpenCaptureButton_Click"
                                    Margin="0,0,4,4" />
                            <Button x:Name="RenameCaptureButton"
                                    Content="Rename"
                                    ToolTip="Rename the selected capture folder."
                                    Click="RenameCaptureButton_Click"
                                    Margin="4,0,0,4" />
                            <Button x:Name="DeleteCaptureButton"
                                    Content="Delete"
                                    ToolTip="Delete the selected capture folder."
                                    Click="DeleteCaptureButton_Click"
                                    Margin="0,4,4,0" />
                            <Button x:Name="RefreshCapturesButton"
                                    Content="Reload"
                                    ToolTip="Reload captures from disk."
                                    Click="RefreshCapturesButton_Click"
                                    Margin="4,4,0,0" />
                            <Button x:Name="EditEvidenceNotesButton"
                                    Content="Notes"
                                    ToolTip="Edit notes for the selected evidence package."
                                    Click="EditEvidenceNotesButton_Click"
                                    Margin="0,4,4,0" />
                            <Button x:Name="CompareCapturesButton"
                                    Content="Compare"
                                    ToolTip="Compare the selected capture against another capture visually and technically."
                                    Click="CompareCapturesButton_Click"
                                    Margin="4,4,0,0" />
                        </UniformGrid>
                        <UniformGrid x:Name="ResultActionsGrid"
                                     Columns="2"
                                     Margin="0,0,0,8">
                            <Button Content="DOM"
                                    ToolTip="Show structured HTML with attribute help."
                                    Click="ShowDomButton_Click"
                                    Margin="0,0,4,4" />
                            <Button Content="CSS"
                                    ToolTip="Show computed styles for the inspected element."
                                    Click="ShowCssButton_Click"
                                    Margin="4,0,0,4" />
                            <Button Content="Console"
                                    ToolTip="Show console messages captured during inspection."
                                    Click="ShowConsoleButton_Click"
                                    Margin="0,4,4,0" />
                            <Button Content="Attributes"
                                    ToolTip="Show attributes for the selected element."
                                    Click="ShowAttributesButton_Click"
                                    Margin="4,4,0,0" />
                            <Button x:Name="ShowImagesButton"
                                    Content="Images"
                                    ToolTip="Preview and save image resources found in the inspected area."
                                    Click="ShowImagesButton_Click"
                                    Margin="0,4,4,0" />
                            <Button x:Name="ShowIssuesButton"
                                    Content="Issues"
                                    ToolTip="Show common accessibility, layout, visibility, and layering issues detected in the current inspection."
                                    Click="ShowIssuesButton_Click"
                                    Margin="4,4,0,0" />
                        </UniformGrid>
                        <Button x:Name="CopyHtmlButton"
                                Content="Copy HTML"
                                ToolTip="Copy the original OuterHTML to the clipboard."
                                Click="CopyHtmlButton_Click"
                                Margin="0,0,0,8" />
                        <Button x:Name="CopyCssButton"
                                Content="Copy CSS"
                                ToolTip="Copy computed CSS to the clipboard."
                                Click="CopyCssButton_Click"
                                Margin="0,0,0,8" />
                        <Button x:Name="ExportJsonButton"
                                Content="Export JSON"
                                ToolTip="Save the current inspection as JSON."
                                Click="ExportJsonButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="ResultsTabControl"
                        Grid.Column="2"
                        Background="{StaticResource PanelBackground}"
                        Foreground="{StaticResource PrimaryText}">
                <TabItem Header="DOM">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.15*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="DOM summary"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedText}"
                                   Margin="8,6,8,4" />

                        <Grid Grid.Row="1" Margin="8,0,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="DomSummaryTextBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Background="{StaticResource InputBackground}"
                                     Foreground="{StaticResource PrimaryText}"
                                     BorderBrush="{StaticResource BorderColor}"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     Padding="8" />

                            <DataGrid x:Name="DomImportantAttributesGrid"
                                      Grid.Column="2"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      Background="{StaticResource InputBackground}"
                                      Foreground="{StaticResource PrimaryText}"
                                      BorderBrush="{StaticResource BorderColor}"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Attribute"
                                                        Binding="{Binding Name}"
                                                        Width="120" />
                                    <DataGridTextColumn Header="Value"
                                                        Binding="{Binding Value}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="Why it matters"
                                                        Binding="{Binding Description}"
                                                        Width="1.25*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Text="Full HTML"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedText}"
                                   Margin="8,0,8,4" />

                        <TextBox x:Name="DomTextBox"
                                 Grid.Row="3"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 Background="{StaticResource InputBackground}"
                                 Foreground="{StaticResource PrimaryText}"
                                 BorderBrush="{StaticResource BorderColor}"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Margin="8,0,8,8" />
                    </Grid>
                </TabItem>
                <TabItem Header="Computed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="CSS explainer"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedText}"
                                   Margin="8,6,8,4" />

                        <DataGrid x:Name="CssExplanationGrid"
                                  Grid.Row="1"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  Background="{StaticResource InputBackground}"
                                  Foreground="{StaticResource PrimaryText}"
                                  BorderBrush="{StaticResource BorderColor}"
                                  GridLinesVisibility="Horizontal"
                                  Margin="8,0,8,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Property"
                                                    Binding="{Binding Property}"
                                                    Width="150" />
                                <DataGridTextColumn Header="Value"
                                                    Binding="{Binding Value}"
                                                    Width="150" />
                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category}"
                                                    Width="115" />
                                <DataGridTextColumn Header="What it does"
                                                    Binding="{Binding Explanation}"
                                                    Width="1.2*" />
                                <DataGridTextColumn Header="Why it matters here"
                                                    Binding="{Binding PracticalHint}"
                                                    Width="1.4*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2"
                                   Text="Full computed CSS"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedText}"
                                   Margin="8,0,8,4" />

                        <TextBox x:Name="ComputedTextBox"
                                 Grid.Row="3"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Background="{StaticResource InputBackground}"
                                 Foreground="{StaticResource PrimaryText}"
                                 BorderBrush="{StaticResource BorderColor}"
                                 Margin="8,0,8,8" />
                    </Grid>
                </TabItem>
                <TabItem Header="CSS Rules">
                    <TextBox x:Name="RulesTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" />
                </TabItem>
                <TabItem Header="Console">
                    <TextBox x:Name="ConsoleTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" />
                </TabItem>
                <TabItem Header="Attributes">
                    <TextBox x:Name="AttributesTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" />
                </TabItem>
                <TabItem Header="Issues">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="IssuesSummaryTextBlock"
                                   Text="No inspection yet."
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedText}"
                                   Margin="8,6,8,4" />

                        <DataGrid x:Name="IssuesGrid"
                                  Grid.Row="1"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  Background="{StaticResource InputBackground}"
                                  Foreground="{StaticResource PrimaryText}"
                                  BorderBrush="{StaticResource BorderColor}"
                                  GridLinesVisibility="Horizontal"
                                  Margin="8,0,8,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity"
                                                    Binding="{Binding Severity}"
                                                    Width="90" />
                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category}"
                                                    Width="120" />
                                <DataGridTextColumn Header="Issue"
                                                    Binding="{Binding Title}"
                                                    Width="1.1*" />
                                <DataGridTextColumn Header="Details"
                                                    Binding="{Binding Details}"
                                                    Width="1.4*" />
                                <DataGridTextColumn Header="Recommendation"
                                                    Binding="{Binding Recommendation}"
                                                    Width="1.5*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2"
                                   Text="Issue report"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedText}"
                                   Margin="8,0,8,4" />

                        <TextBox x:Name="IssuesTextBox"
                                 Grid.Row="3"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Background="{StaticResource InputBackground}"
                                 Foreground="{StaticResource PrimaryText}"
                                 BorderBrush="{StaticResource BorderColor}"
                                 Margin="8,0,8,8" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border x:Name="StatusBorder"
                Grid.Row="2"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       Text="Ready"
                       VerticalAlignment="Center"
                       Margin="16,0"
                       Foreground="{StaticResource MutedText}" />
        </Border>
    </Grid>
</Window>
