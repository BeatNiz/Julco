<Window x:Class="Julco.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco"
        Icon="/Julco.UI;component/Resources/julco.ico"
        Width="1180"
        Height="760"
        MinWidth="260"
        MinHeight="520"
        Background="#101217"
        Foreground="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#181B22" />
        <SolidColorBrush x:Key="BorderColor" Color="#2A2F3A" />
        <SolidColorBrush x:Key="MutedText" Color="#AAB2C0" />
        <SolidColorBrush x:Key="ControlBackground" Color="#202630" />
        <SolidColorBrush x:Key="ControlHover" Color="#2A3340" />
        <SolidColorBrush x:Key="ControlPressed" Color="#334155" />
        <SolidColorBrush x:Key="Accent" Color="#40C7FF" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="#3A4656" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHover}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlPressed}" />
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#0F1218" />
            <Setter Property="BorderBrush" Value="#3A4656" />
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="CaretBrush" Value="#F4F6F8" />
            <Setter Property="SelectionBrush" Value="#40C7FF" />
        </Style>
        <Style x:Key="BrowserLogoButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder"
                Grid.Row="0"
                Background="#181B22"
                BorderBrush="#2A2F3A"
                BorderThickness="0,0,0,1">
            <DockPanel x:Name="HeaderPanel" Margin="14,8">
                <Image x:Name="LogoImage"
                       Source="/Julco.UI;component/Resources/julco-logo-dark.png"
                       Width="62"
                       Height="62"
                       VerticalAlignment="Center"
                       Stretch="Uniform"
                       ToolTip="Julco" />

                <WrapPanel x:Name="HeaderActionsPanel"
                           DockPanel.Dock="Right"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0">
                    <TextBlock Text="CDP"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="PortTextBox"
                             Width="72"
                             Text="9222"
                             ToolTip="Local port used to connect through Chrome DevTools Protocol."
                             Margin="0,0,10,0" />
                    <Button x:Name="LaunchChromeButton"
                            Content="◉"
                            Foreground="#4EA1FF"
                            Style="{StaticResource BrowserLogoButton}"
                            ToolTip="Open Chrome with the configured CDP port."
                            Click="LaunchChromeButton_Click"
                            Margin="0,0,8,0" />
                    <Button x:Name="LaunchEdgeButton"
                            Content="e"
                            Foreground="#38BDF8"
                            Style="{StaticResource BrowserLogoButton}"
                            ToolTip="Open Microsoft Edge with the configured CDP port."
                            Click="LaunchEdgeButton_Click"
                            Margin="0,0,8,0" />
                    <Button x:Name="LaunchOperaButton"
                            Content="O"
                            Foreground="#FF1B2D"
                            Style="{StaticResource BrowserLogoButton}"
                            ToolTip="Open Opera with the configured CDP port."
                            Click="LaunchOperaButton_Click"
                            Margin="0,0,8,0" />
                    <Button x:Name="LaunchFirefoxButton"
                            Content="F"
                            Foreground="#FF7A18"
                            Style="{StaticResource BrowserLogoButton}"
                            ToolTip="Firefox uses a different protocol; Julco will explain the limitation."
                            Click="LaunchFirefoxButton_Click"
                            Margin="0,0,8,0" />
                    <Button x:Name="RefreshTargetsButton"
                            Content="Tabs"
                            ToolTip="Refresh the list of inspectable web pages."
                            Click="RefreshTargetsButton_Click"
                            Margin="0,0,8,0" />
                    <Button x:Name="LensButton"
                            Content="Lens"
                            ToolTip="Open or close the technical lens frame."
                            Click="LensButton_Click"
                            Margin="0,0,8,0" />
                    <Button x:Name="SettingsButton"
                            Content="⚙"
                            ToolTip="Open Julco settings."
                            Click="SettingsButton_Click" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="330" />
                <ColumnDefinition x:Name="GapColumn" Width="16" />
                <ColumnDefinition x:Name="ResultsColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="InspectorTitleTextBlock"
                                   Text="CDP Inspection"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="InspectorHelpTextBlock"
                                   Text="Open Chrome or Edge from Julco, choose a tab, and inspect a CSS selector."
                                   Margin="0,8,0,16"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedText}" />

                        <TextBlock Text="Tab"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedText}" />
                        <ComboBox x:Name="TargetsComboBox"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="Web page to inspect through CDP."
                                  Margin="0,4,0,14" />

                        <TextBlock Text="CSS selector"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedText}" />
                        <TextBox x:Name="SelectorTextBox"
                                 Text="body"
                                 ToolTip="CSS selector to inspect. Examples: body, #app, .card, button."
                                 Margin="0,4,0,10" />

                        <Button x:Name="InspectButton"
                                Content="Inspect selector"
                                ToolTip="Get DOM, computed CSS, matched rules, and attributes for the selector."
                                Click="InspectButton_Click"
                                Margin="0,0,0,16" />

                        <TextBlock Text="Element"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="ElementTextBlock"
                                   Text="-"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="URL"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="UrlTextBlock"
                                   Text="-"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Lens"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="LensStateTextBlock"
                                   Text="Inactive"
                                   Margin="0,4,0,14"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.2*" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="HistoryListBox"
                                 Grid.Row="0"
                                 MinHeight="120"
                                 Background="#111318"
                                 Foreground="#F4F6F8"
                                 BorderBrush="{StaticResource BorderColor}" />

                        <TextBlock Grid.Row="1"
                                   Text="Captures"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedText}"
                                   Margin="0,10,0,4" />

                        <ListBox x:Name="CaptureFilesListBox"
                                 Grid.Row="2"
                                 DisplayMemberPath="DisplayName"
                                 MinHeight="160"
                                 Background="#111318"
                                 Foreground="#F4F6F8"
                                 BorderBrush="{StaticResource BorderColor}" />
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <Button x:Name="CaptureLensButton"
                                Content="Capture lens"
                                ToolTip="Save the delimited image and current DOM/CSS/Console/Attributes data."
                                Click="CaptureLensButton_Click"
                                Margin="0,0,0,8" />
                        <UniformGrid Columns="2"
                                     Margin="0,0,0,8">
                            <Button x:Name="OpenCaptureButton"
                                    Content="Open"
                                    ToolTip="Open the selected capture folder."
                                    Click="OpenCaptureButton_Click"
                                    Margin="0,0,4,4" />
                            <Button x:Name="RenameCaptureButton"
                                    Content="Rename"
                                    ToolTip="Rename the selected capture folder."
                                    Click="RenameCaptureButton_Click"
                                    Margin="4,0,0,4" />
                            <Button x:Name="DeleteCaptureButton"
                                    Content="Delete"
                                    ToolTip="Delete the selected capture folder."
                                    Click="DeleteCaptureButton_Click"
                                    Margin="0,4,4,0" />
                            <Button x:Name="RefreshCapturesButton"
                                    Content="Reload"
                                    ToolTip="Reload captures from disk."
                                    Click="RefreshCapturesButton_Click"
                                    Margin="4,4,0,0" />
                        </UniformGrid>
                        <UniformGrid Columns="2"
                                     Margin="0,0,0,8">
                            <Button Content="DOM"
                                    ToolTip="Show structured HTML with attribute help."
                                    Click="ShowDomButton_Click"
                                    Margin="0,0,4,4" />
                            <Button Content="CSS"
                                    ToolTip="Show computed styles for the inspected element."
                                    Click="ShowCssButton_Click"
                                    Margin="4,0,0,4" />
                            <Button Content="Console"
                                    ToolTip="Show console messages captured during inspection."
                                    Click="ShowConsoleButton_Click"
                                    Margin="0,4,4,0" />
                            <Button Content="Attributes"
                                    ToolTip="Show attributes for the selected element."
                                    Click="ShowAttributesButton_Click"
                                    Margin="4,4,0,0" />
                        </UniformGrid>
                        <Button x:Name="CopyHtmlButton"
                                Content="Copy HTML"
                                ToolTip="Copy the original OuterHTML to the clipboard."
                                Click="CopyHtmlButton_Click"
                                Margin="0,0,0,8" />
                        <Button x:Name="CopyCssButton"
                                Content="Copy CSS"
                                ToolTip="Copy computed CSS to the clipboard."
                                Click="CopyCssButton_Click"
                                Margin="0,0,0,8" />
                        <Button x:Name="ExportJsonButton"
                                Content="Export JSON"
                                ToolTip="Save the current inspection as JSON."
                                Click="ExportJsonButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="ResultsTabControl"
                        Grid.Column="2"
                        Background="#101217"
                        Foreground="#F4F6F8">
                <TabItem Header="DOM">
                    <TextBox x:Name="DomTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             Background="#050608"
                             Foreground="#D4D4D4"
                             BorderBrush="#2A2F3A"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" />
                </TabItem>
                <TabItem Header="Computed">
                    <TextBox x:Name="ComputedTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" />
                </TabItem>
                <TabItem Header="CSS Rules">
                    <TextBox x:Name="RulesTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" />
                </TabItem>
                <TabItem Header="Console">
                    <TextBox x:Name="ConsoleTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" />
                </TabItem>
                <TabItem Header="Attributes">
                    <TextBox x:Name="AttributesTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" />
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2"
                Background="#181B22"
                BorderBrush="#2A2F3A"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       Text="Ready"
                       VerticalAlignment="Center"
                       Margin="16,0"
                       Foreground="{StaticResource MutedText}" />
        </Border>
    </Grid>
</Window>
