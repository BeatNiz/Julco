<Window x:Class="Julco.UI.LensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco Lens"
        Width="420"
        Height="260"
        MinWidth="240"
        MinHeight="44"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        LocationChanged="Window_StateChanged">
    <Canvas x:Name="RootCanvas">
        <Grid x:Name="CaptureFrame"
              Width="420"
              Height="260"
              Canvas.Left="0"
              Canvas.Top="0">
            <Border BorderBrush="#40C7FF"
                    BorderThickness="2"
                    Background="#22101318"
                    CornerRadius="4" />

            <Grid x:Name="GuideGrid"
                  IsHitTestVisible="False"
                  Margin="2,26,2,2">
                <Rectangle Height="1"
                           Fill="#6640C7FF"
                           VerticalAlignment="Center" />
                <Rectangle Width="1"
                           Fill="#6640C7FF"
                           HorizontalAlignment="Center" />
                <Ellipse Width="8"
                         Height="8"
                         Fill="#40C7FF"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Grid>

            <Border x:Name="ResizeHandle"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,4,4"
                    Background="#8840C7FF"
                    Cursor="SizeNWSE"
                    MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"
                    MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"
                    MouseMove="ResizeHandle_MouseMove" />
        </Grid>

        <Border x:Name="HeaderBorder"
                Height="26"
                MinWidth="240"
                Width="420"
                Background="#E8181B22"
                BorderBrush="#40C7FF"
                BorderThickness="0,0,0,1"
                Canvas.Left="0"
                Canvas.Top="0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <DockPanel Margin="8,0">
                <Button x:Name="CaptureButton"
                        DockPanel.Dock="Left"
                        Content="⌖"
                        Width="22"
                        Height="20"
                        Padding="0"
                        Margin="0,0,8,0"
                        Background="#25313D"
                        BorderBrush="#66D9FF"
                        Foreground="#FFFFFF"
                        FontSize="13"
                        FontWeight="SemiBold"
                        ToolTip="Capture the current lens region."
                        Click="CaptureButton_Click" />
                <Button x:Name="FreezeButton"
                        DockPanel.Dock="Left"
                        Content="F"
                        Width="22"
                        Height="20"
                        Padding="0"
                        Margin="0,0,6,0"
                        Background="#25313D"
                        BorderBrush="#66D9FF"
                        Foreground="#FFFFFF"
                        FontSize="11"
                        ToolTip="Freeze live inspection results without closing the lens."
                        Click="FreezeButton_Click" />
                <Button x:Name="LockButton"
                        DockPanel.Dock="Left"
                        Content="L"
                        Width="22"
                        Height="20"
                        Padding="0"
                        Margin="0,0,8,0"
                        Background="#25313D"
                        BorderBrush="#66D9FF"
                        Foreground="#FFFFFF"
                        FontSize="11"
                        ToolTip="Lock lens movement and resizing."
                        Click="LockButton_Click" />
                <TextBlock x:Name="TypeTextBlock"
                           DockPanel.Dock="Right"
                           Text="type: -"
                           VerticalAlignment="Center"
                           Foreground="#AAB2C0"
                           FontSize="10"
                           Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PositionTextBlock"
                           Text="Lens"
                           VerticalAlignment="Center"
                           Foreground="#F4F6F8"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Canvas>
</Window>
