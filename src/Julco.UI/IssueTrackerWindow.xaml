<Window x:Class="Julco.UI.IssueTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco - Issue Trackers"
        Width="860"
        Height="680"
        MinWidth="620"
        MinHeight="520"
        Background="#101217"
        Foreground="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#181B22" />
        <SolidColorBrush x:Key="InputBackground" Color="#0F1218" />
        <SolidColorBrush x:Key="BorderColor" Color="#2A2F3A" />
        <SolidColorBrush x:Key="MutedText" Color="#AAB2C0" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F6F8" />
        <SolidColorBrush x:Key="ControlBackground" Color="#202630" />
        <SolidColorBrush x:Key="Accent" Color="#40C7FF" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryText}" />
            <Setter Property="SelectionBrush" Value="#40C7FF" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Issue tracker handoff"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="Choose a target format, then copy the title and body into your tracker."
                           Foreground="{StaticResource MutedText}"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox x:Name="DraftComboBox"
                      Grid.Column="1"
                      DisplayMemberPath="Name"
                      SelectionChanged="DraftComboBox_SelectionChanged"
                      VerticalAlignment="Top" />
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Title"
                           Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <TextBox x:Name="TitleTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         IsReadOnly="True" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Saved"
                           Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Margin="0,8,0,0" />
                <TextBox x:Name="SavedPathTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         IsReadOnly="True"
                         Margin="0,8,0,0" />
            </Grid>
        </Border>

        <TextBox x:Name="BodyTextBox"
                 Grid.Row="2"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" />

        <UniformGrid Grid.Row="3"
                     Columns="4"
                     Margin="0,12,0,0">
            <Button Content="Copy title"
                    Click="CopyTitleButton_Click"
                    Margin="0,0,6,0" />
            <Button Content="Copy body"
                    Click="CopyBodyButton_Click"
                    Margin="6,0,6,0" />
            <Button Content="Copy both"
                    Click="CopyBothButton_Click"
                    Margin="6,0,6,0" />
            <Button Content="Open folder"
                    Click="OpenFolderButton_Click"
                    Margin="6,0,0,0" />
        </UniformGrid>
    </Grid>
</Window>
