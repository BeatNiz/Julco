<Window x:Class="Julco.UI.PrivacyPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco - Privacy Preview"
        Width="980"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#101217"
        Foreground="#F4F6F8">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#171C25" />
        <SolidColorBrush x:Key="InputBackground" Color="#090C11" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F6F8" />
        <SolidColorBrush x:Key="MutedText" Color="#AAB2C0" />
        <SolidColorBrush x:Key="BorderColor" Color="#2A3342" />
        <SolidColorBrush x:Key="Accent" Color="#44C8FF" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#202937" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Privacy Preview" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,12" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,12,0">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Redaction summary" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                    <TextBox x:Name="SummaryTextBox"
                             DockPanel.Dock="Top"
                             Margin="0,10,0,14"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Background="{StaticResource InputBackground}"
                             Foreground="{StaticResource PrimaryText}"
                             BorderBrush="{StaticResource BorderColor}"
                             MinHeight="150" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="Affected fields"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"
                               Margin="0,0,0,8" />
                    <ListBox x:Name="FieldPreviewListBox"
                             DockPanel.Dock="Top"
                             MinHeight="120"
                             DisplayMemberPath="SummaryText"
                             Background="{StaticResource InputBackground}"
                             Foreground="{StaticResource PrimaryText}"
                             BorderBrush="{StaticResource BorderColor}"
                             SelectionChanged="FieldPreviewListBox_SelectionChanged" />
                    <TextBlock Text="Safe export keeps redacted technical files separate from the original capture package."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedText}" />
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <TabControl>
                    <TabItem Header="Text">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Original sample" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Safe sample" FontWeight="SemiBold" Margin="10,0,0,0" />

                            <TextBox x:Name="OriginalTextBox"
                                     Grid.Row="1"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="{StaticResource InputBackground}"
                                     Foreground="{StaticResource PrimaryText}"
                                     BorderBrush="{StaticResource BorderColor}"
                                     Margin="0,8,5,0" />
                            <TextBox x:Name="RedactedTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="{StaticResource InputBackground}"
                                     Foreground="{StaticResource PrimaryText}"
                                     BorderBrush="{StaticResource BorderColor}"
                                     Margin="5,8,0,0" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Screenshot">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ScreenshotStatusTextBlock"
                                       Foreground="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <Border Grid.Row="1"
                                    Background="{StaticResource InputBackground}"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1">
                                <Image x:Name="ScreenshotPreviewImage"
                                       Stretch="Uniform" />
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Copy summary" Click="CopySummaryButton_Click" Margin="0,0,8,0" />
            <Button Content="Export safe package" Click="ExportSafeButton_Click" Margin="0,0,8,0" />
            <Button Content="Close" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
