<Window x:Class="Julco.UI.CssResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco - CSS"
        Width="900"
        Height="640"
        MinWidth="560"
        MinHeight="420"
        Background="#101217"
        Foreground="#F4F6F8"
        Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="1.1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#181B22"
                BorderBrush="#2A2F3A"
                BorderThickness="0,0,0,1">
            <TextBlock Text="CSS explainer"
                       VerticalAlignment="Center"
                       Margin="14,0"
                       FontWeight="SemiBold" />
        </Border>

        <DataGrid x:Name="CssExplanationGrid"
                  Grid.Row="1"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  Background="#050608"
                  Foreground="#F4F6F8"
                  BorderBrush="#2A2F3A"
                  GridLinesVisibility="Horizontal"
                  Margin="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Property"
                                    Binding="{Binding Property}"
                                    Width="145" />
                <DataGridTextColumn Header="Value"
                                    Binding="{Binding Value}"
                                    Width="145" />
                <DataGridTextColumn Header="Category"
                                    Binding="{Binding Category}"
                                    Width="110" />
                <DataGridTextColumn Header="What it does"
                                    Binding="{Binding Explanation}"
                                    Width="1.15*" />
                <DataGridTextColumn Header="Why it matters here"
                                    Binding="{Binding PracticalHint}"
                                    Width="1.35*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="Full computed CSS"
                   Foreground="#AAB2C0"
                   FontWeight="SemiBold"
                   Margin="12,0,12,4" />

        <TextBox x:Name="ComputedCssTextBox"
                 Grid.Row="3"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="#050608"
                 Foreground="#F4F6F8"
                 BorderBrush="#2A2F3A"
                 FontFamily="Consolas"
                 FontSize="13"
                 Margin="12,0,12,12" />
    </Grid>
</Window>
