<Window x:Class="Julco.UI.CommonIssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Julco - Issues"
        Width="920"
        Height="620"
        MinWidth="560"
        MinHeight="420"
        Background="#101217"
        Foreground="#F4F6F8"
        Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="1.2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#181B22"
                BorderBrush="#2A2F3A"
                BorderThickness="0,0,0,1">
            <TextBlock x:Name="TitleTextBlock"
                       VerticalAlignment="Center"
                       Margin="14,0"
                       FontWeight="SemiBold" />
        </Border>

        <DataGrid x:Name="IssuesGrid"
                  Grid.Row="1"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  Background="#050608"
                  Foreground="#F4F6F8"
                  BorderBrush="#2A2F3A"
                  GridLinesVisibility="Horizontal"
                  Margin="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                <DataGridTextColumn Header="Issue" Binding="{Binding Title}" Width="1.1*" />
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="1.45*" />
                <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="1.5*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="Report"
                   Foreground="#AAB2C0"
                   FontWeight="SemiBold"
                   Margin="12,0,12,4" />

        <TextBox x:Name="IssuesTextBox"
                 Grid.Row="3"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="#050608"
                 Foreground="#F4F6F8"
                 BorderBrush="#2A2F3A"
                 FontFamily="Consolas"
                 FontSize="13"
                 Margin="12,0,12,12" />
    </Grid>
</Window>
